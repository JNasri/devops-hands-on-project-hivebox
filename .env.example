# HiveBox application
LOG_LEVEL=INFO
APP_TRUST_PROXY=false
API_RATE_LIMIT_PER_MINUTE=60
STORE_API_KEY=
STORE_INTERVAL_SECONDS=300

# openSenseMap
TEMPERATURE_API_URL=https://api.opensensemap.org/boxes/data
TEMPERATURE_PHENOMENA=Temperatur,Temperature,Temperatura,Température,Lufttemperatur
TEMPERATURE_BBOX=5.5,47.2,15.2,55.1
TEMPERATURE_SENSEBOX_IDS=5eba5fbad46fb8001b799786,5c21ff8f919bf8001adf2488,5ade1acf223bd80019a1011c
TEMPERATURE_REQUEST_TIMEOUT=15
TEMPERATURE_UNIT=°C
READYZ_REQUEST_TIMEOUT=2

# Nominatim. Replace the example URL with your repository or contact address.
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=HiveBox/0.0.1 (https://github.com/your-account/hivebox)

# Valkey
VALKEY_URL=redis://localhost:6379

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hivebox
MINIO_SECURE=false
